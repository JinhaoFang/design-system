            "jumpRate": [
              2.5,
              10
            ],
            "layoutRate": [
              0.18,
              0.65
            ],
            "imageRate": [
              0,
              0.6
            ]
          }
        }
      },
      "entrance": {
        "opacity": {
          "step": "snap",
          "ease": "fade"
        }
      }
    }
