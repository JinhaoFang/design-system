{% comment %}
星表 xingbiao：方向稿 B 的「星表」段。左栏是段号和小标题，右栏是一张数据表：墨线起、发丝线分行，标签在左（ink-2），数字靠右对齐（Source Serif 300，head 档，等高等宽数字），
像星表里的一栏读数。左栏下方是一句引语（lead 字号，宋体，悬挂起始引号，与表格底边对齐），落款用楷书 ink-2 加破折号；最后一条发丝线上排合作方的标识，墨色、等高、左对齐，不做灰阶处理。
入场：小标题上浮，表行逐行洇出（line 错峰），引语与标识随后洇出。
手机：单栏，引语在表格之前，表格保持两列，数字降到 sub 档；标识两行折排。
{% endcomment %}
<style>
  :scope {
    box-sizing: border-box;
    position: relative;
    padding: var(--ds-space-9) var(--ds-space-8);
    background: var(--ds-color-paper);
    color: var(--ds-color-ink);
    font-family: var(--ds-font-body);
    font-size: var(--ds-type-body);
    line-height: 1.85;
    counter-increment: pe-juan;
  }
  :scope::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: .45;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .30 0 0 0 0 .24 0 0 0 0 .17 0 0 0 .16 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }
  :scope * { box-sizing: border-box; }
  h2, h3, p, ul, ol, li, figure, figcaption, dl, dt, dd, blockquote { margin: 0; padding: 0; }
  ul, ol { list-style: none; }
  .yuwei { display: block; flex: none; width: 24px; height: 16px; fill: var(--ds-color-ink); }
  .no::before { content: counter(pe-juan, simp-chinese-formal); }
  .sec { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: var(--ds-space-8); max-width: 1240px; margin: 0 auto; }
  .tag { display: flex; align-items: center; gap: var(--ds-space-3); font-size: var(--ds-type-note); font-weight: 600; letter-spacing: .3em; color: var(--ds-color-ink-3); }
  .heading { margin-top: var(--ds-space-5); font-size: var(--ds-type-head); font-weight: 400; line-height: 1.35; letter-spacing: .04em; text-wrap: balance; }
  .table { border-top: 1px solid var(--ds-color-ink); }
  .table div { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: var(--ds-space-6); padding: var(--ds-space-4) 0; border-bottom: 1px solid var(--ds-color-rule-light); }
  .table dt { color: var(--ds-color-ink-2); letter-spacing: .06em; }
  .table dd { font-family: var(--ds-font-latin); font-size: var(--ds-type-head); font-weight: 300; line-height: 1.1; font-feature-settings: "lnum" 1, "tnum" 1; }
  .side { display: flex; flex-direction: column; }
  .quote { margin-top: auto; padding-top: var(--ds-space-7); }
  .quote blockquote { max-width: 20em; font-size: var(--ds-type-lead); line-height: 1.9; text-indent: -.5em; text-wrap: pretty; font-feature-settings: "onum" 1; }
  .quote blockquote::before { content: "「"; }
  .quote blockquote::after { content: "」"; }
  .quote p { margin-top: var(--ds-space-4); font-family: var(--ds-font-kai); letter-spacing: .1em; color: var(--ds-color-ink-2); }
  .quote p::before { content: "—— "; }
  .logos { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: var(--ds-space-5) var(--ds-space-7); margin-top: var(--ds-space-8); padding-top: var(--ds-space-5); border-top: 1px solid var(--ds-color-rule); }
  .logos img { display: block; height: 56px; width: auto; }
  @media (max-width: 860px) {
    :scope { padding: var(--ds-space-9) var(--ds-space-5); }
    .sec { grid-template-columns: minmax(0, 1fr); gap: var(--ds-space-6); }
    .heading { font-size: var(--ds-type-sub); }
    .table dd { font-size: var(--ds-type-sub); }
    .quote { padding-top: var(--ds-space-5); }
    .quote blockquote { font-size: var(--ds-type-body); }
    .logos { grid-column: 1; margin-top: var(--ds-space-4); gap: var(--ds-space-4) var(--ds-space-5); }
    .logos img { height: 40px; }
  }
</style>
<div class="sec">
  <div class="side">
    <div data-ds-enter="rise" data-ds-step="glide" data-ds-ease="paper" data-ds-distance="3" data-ds-order="0">
    <p class="tag" aria-hidden="true"><svg class="yuwei" viewBox="0 0 24 16" aria-hidden="true"><path d="M0 0H24V10L17 5.5L12 11.5L7 5.5L0 10Z"/></svg><span class="no"></span></p>
    <h2 class="heading">{{ slots.heading }}</h2>
    </div>
    <div class="quote" data-ds-enter="fade" data-ds-step="ink" data-ds-ease="ink" data-ds-order="1">
      <blockquote>{{ slots.quote }}</blockquote>
      <p>{{ slots.quoteBy }}</p>
    </div>
  </div>
  <dl class="table" data-ds-stagger="line">
    {% for stat in slots.stats %}<div data-ds-enter="fade" data-ds-step="ink" data-ds-ease="ink"><dt>{{ slots.statLabels[forloop.index0] }}</dt><dd>{{ stat }}</dd></div>
    {% endfor %}
  </dl>
  <div class="logos" data-ds-enter="fade" data-ds-step="ink" data-ds-ease="ink" data-ds-order="2">
    {% for logo in slots.logos %}{{ logo }}
    {% endfor %}
  </div>
</div>
