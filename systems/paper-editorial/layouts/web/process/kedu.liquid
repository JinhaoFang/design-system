{% comment %}
刻度 kedu：把流程画成一把工程图里的标尺。一条 2px 墨线横贯全宽，每一步是线上的一枚墨圈（○），最后一步实心朱点；事项和说明在线的上下交替排开（单数在上、双数在下），
像图纸上错开的标注，避免排成一行等大的格子。事项宋体 400 lead 档，说明 note 字号 ink-2、等宽数字。小标题在左上，鱼尾 + 卷次在前。最多六步。
入场：标尺洇出，各步从左到右逐个洇出（line 错峰）。
手机：标尺改为竖线靠左，各步在线右侧自上而下。
{% endcomment %}
<style>
  :scope {
    box-sizing: border-box;
    position: relative;
    padding: var(--ds-space-9) var(--ds-space-8);
    background: var(--ds-color-paper);
    color: var(--ds-color-ink);
    font-family: var(--ds-font-body);
    font-size: var(--ds-type-body);
    line-height: 1.85;
    counter-increment: pe-juan;
  }
  :scope::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: .45;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .30 0 0 0 0 .24 0 0 0 0 .17 0 0 0 .16 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }
  :scope * { box-sizing: border-box; }
  h2, h3, p, ul, ol, li, figure, figcaption, dl, dt, dd, blockquote { margin: 0; padding: 0; }
  ul, ol { list-style: none; }
  .yuwei { display: block; flex: none; width: 24px; height: 16px; fill: var(--ds-color-ink); }
  .no::before { content: counter(pe-juan, simp-chinese-formal); }
  .wrap { max-width: 1240px; margin: 0 auto; }
  .top { display: flex; align-items: center; gap: var(--ds-space-3); }
  .top .no { font-size: var(--ds-type-note); font-weight: 600; letter-spacing: .3em; color: var(--ds-color-ink-3); }
  .heading { margin-left: var(--ds-space-3); font-size: var(--ds-type-head); font-weight: 400; line-height: 1.35; letter-spacing: .04em; }
  .scale {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-template-rows: auto 40px auto;
    column-gap: var(--ds-space-5);
    margin-top: var(--ds-space-8);
  }
  .scale::before { content: ""; position: absolute; left: 0; right: 0; top: 50%; border-top: 2px solid var(--ds-color-ink); }
  .scale li { display: contents; }
  .txt { padding: var(--ds-space-3) 0; border-left: 1px solid var(--ds-color-rule); padding-left: var(--ds-space-3); }
  .scale li:nth-child(odd) .txt { grid-row: 1; align-self: end; }
  .scale li:nth-child(even) .txt { grid-row: 3; align-self: start; }
  .dot { grid-row: 2; align-self: center; position: relative; z-index: 1; display: block; width: 14px; height: 14px; transform: translateX(-50%); fill: var(--ds-color-paper); stroke: var(--ds-color-ink); stroke-width: 1.5; }
  .scale li:last-child .dot { fill: var(--ds-color-zhu); stroke: var(--ds-color-zhu); }
  .scale li:nth-child(1) > * { grid-column: 1; }
  .scale li:nth-child(2) > * { grid-column: 2; }
  .scale li:nth-child(3) > * { grid-column: 3; }
  .scale li:nth-child(4) > * { grid-column: 4; }
  .scale li:nth-child(5) > * { grid-column: 5; }
  .scale li:nth-child(6) > * { grid-column: 6; }
  .txt h3 { font-size: var(--ds-type-lead); font-weight: 400; line-height: 1.4; letter-spacing: .04em; }
  .txt p { margin-top: var(--ds-space-1); font-size: var(--ds-type-note); line-height: 1.7; color: var(--ds-color-ink-2); text-wrap: pretty; font-feature-settings: "lnum" 1, "tnum" 1; }
  @media (max-width: 860px) {
    :scope { padding: var(--ds-space-9) var(--ds-space-5); }
    .heading { font-size: var(--ds-type-sub); }
    .scale { grid-template-columns: 24px minmax(0, 1fr); grid-template-rows: none; column-gap: var(--ds-space-3); row-gap: var(--ds-space-4); margin-top: var(--ds-space-7); }
    .scale::before { left: 11px; right: auto; top: 0; bottom: 0; border-top: 0; border-left: 2px solid var(--ds-color-ink); }
    .scale li:nth-child(n) .txt { grid-column: 2; grid-row: auto; align-self: start; border-left: 0; padding: 0; }
    .scale li:nth-child(n) .dot { grid-column: 1; grid-row: auto; align-self: start; justify-self: center; margin-top: var(--ds-space-1); transform: none; }
    .txt h3 { font-size: var(--ds-type-body); }
  }
</style>
<div class="wrap">
  <div class="top" data-ds-enter="rise" data-ds-step="glide" data-ds-ease="paper" data-ds-distance="3" data-ds-order="0"><svg class="yuwei" viewBox="0 0 24 16" aria-hidden="true"><path d="M0 0H24V10L17 5.5L12 11.5L7 5.5L0 10Z"/></svg><span class="no" aria-hidden="true"></span><h2 class="heading">{{ slots.heading }}</h2></div>
  <ol class="scale" data-ds-stagger="line">
    {% for step in slots.steps %}<li><svg class="dot" viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="6"/></svg><div class="txt" data-ds-enter="fade" data-ds-step="ink" data-ds-ease="ink"><h3>{{ step }}</h3><p>{{ slots.stepNotes[forloop.index0] }}</p></div></li>
    {% endfor %}
  </ol>
</div>
