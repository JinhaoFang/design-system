{% comment %}
对表 duibiao：把两边写成一张逐行对照的表。左上标题（朱雀仿宋、title 档）；右边三分之二是表：表头两栏（左 ink-2、右 ink，宋体 600、lead），下面逐行对齐，每行一条 rule-light 界栏，行间以一个细长的墨色「→」连接旧与新。结论横排在表下（body，ink-2）。
朱色：无。入场：标题升起，表头洇出，各行自上而下错峰 line。
{% endcomment %}
<style>
  :scope {
    box-sizing: border-box;
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    padding: var(--ds-space-7) var(--ds-space-7);
    background: var(--ds-color-paper);
    color: var(--ds-color-ink);
    font-family: var(--ds-font-body);
    text-spacing-trim: trim-both;
  }
  :scope::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: .45;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .30 0 0 0 0 .24 0 0 0 0 .17 0 0 0 .16 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }
  p, h1, h2, ol, ul, li, figure, figcaption, blockquote { margin: 0; padding: 0; }
  p, li, blockquote { text-wrap: pretty; }
  h1, h2 { text-wrap: balance; }

  .page {
    display: grid;
    grid-template-columns: 4fr 9fr;
    column-gap: var(--ds-space-8);
    height: 100%;
  }
  .heading {
    padding-top: var(--ds-space-5);
    font-size: var(--ds-type-title);
    font-family: var(--ds-font-latin), var(--ds-font-cjk-display);
    font-weight: 400;
    letter-spacing: .04em;
    line-height: 1.2;
  }
  .table { align-self: center; }
  .cols {
    display: grid;
    grid-template-columns: 1fr var(--ds-space-7) 1fr;
    padding-bottom: var(--ds-space-3);
    border-bottom: 2px solid var(--ds-color-ink);
    font-family: var(--ds-font-cjk);
    font-size: var(--ds-type-lead);
    font-weight: 600;
    letter-spacing: .04em;
  }
  .cols .l, .row .l { color: var(--ds-color-ink-2); }
  .rows { display: grid; grid-template-columns: 1fr var(--ds-space-7) 1fr; }
  .rows ul { list-style: none; }
  .rows li {
    height: 2.6em;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--ds-color-rule-light);
    font-size: var(--ds-type-body);
    line-height: 1.4;
  }
  .rows .l li { color: var(--ds-color-ink-2); }
  .arrows { list-style: none; }
  .arrows li { justify-content: center; color: var(--ds-color-ink-3); font-family: var(--ds-font-latin); }
  .verdict {
    margin-top: var(--ds-space-5);
    font-size: var(--ds-type-body);
    line-height: 1.6;
    color: var(--ds-color-ink-2);
  }
  .verdict:has(> :empty) { display: none; }
</style>
<div class="page">
  <h1 class="heading" data-ds-enter="rise" data-ds-step="glide" data-ds-ease="paper" data-ds-distance="3" data-ds-order="1">{{ slots.heading }}</h1>
  <div class="table">
    <div class="cols" data-ds-enter="fade" data-ds-step="ink" data-ds-ease="ink" data-ds-order="2"><span class="l">{{ slots.leftTitle }}</span><span></span><span>{{ slots.rightTitle }}</span></div>
    <div class="rows" data-ds-enter="fade" data-ds-step="ink" data-ds-ease="ink" data-ds-order="3">
      <ul class="l">{% for p in slots.leftPoints %}<li>{{ p }}</li>{% endfor %}</ul>
      <ul class="arrows" aria-hidden="true">{% for p in slots.leftPoints %}<li>→</li>{% endfor %}</ul>
      <ul class="r">{% for p in slots.rightPoints %}<li>{{ p }}</li>{% endfor %}</ul>
    </div>
    <p class="verdict" data-ds-enter="fade" data-ds-step="ink" data-ds-ease="ink" data-ds-order="4">{{ slots.verdict }}</p>
  </div>
</div>
