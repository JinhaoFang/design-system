{% comment %}
分卷 fenjuan：日志的分卷页。下半页一条 2px 墨线，线上左边是超大的卷号（Source Serif 300 等高数字、colossal 档），右边标题（宋体 200、title 档）与摘要（lead ink-2）底边对齐。上半页留空，像翻开新的一卷。
朱色：无。入场：卷号从左滑入，标题升起，摘要最后洇出。
{% endcomment %}
<style>
  :scope {
    box-sizing: border-box;
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    padding: var(--ds-space-6) var(--ds-space-7);
    background: var(--ds-color-paper);
    color: var(--ds-color-ink);
    font-family: var(--ds-font-body);
    text-spacing-trim: trim-both;
  }
  :scope::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: .45;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .30 0 0 0 0 .24 0 0 0 0 .17 0 0 0 .16 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }
  p, h1, h2, ol, ul, li, figure, figcaption, blockquote { margin: 0; padding: 0; }
  p, li, blockquote { text-wrap: pretty; }
  h1, h2 { text-wrap: balance; }

  .vol {
    position: absolute;
    left: var(--ds-space-7);
    right: var(--ds-space-7);
    bottom: var(--ds-space-8);
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--ds-space-8);
    align-items: end;
    padding-bottom: var(--ds-space-5);
    border-bottom: 2px solid var(--ds-color-ink);
  }
  .number {
    font-family: var(--ds-font-latin);
    font-size: var(--ds-type-colossal);
    font-weight: 300;
    font-feature-settings: "lnum" 1;
    letter-spacing: -.02em;
    line-height: .8;
  }
  .title {
    font-family: var(--ds-font-cjk);
    font-size: var(--ds-type-title);
    font-weight: 200;
    letter-spacing: .04em;
    line-height: 1.2;
  }
  .summary {
    margin-top: var(--ds-space-4);
    max-width: 22em;
    font-size: var(--ds-type-lead);
    letter-spacing: .04em;
    line-height: 1.6;
    color: var(--ds-color-ink-2);
  }
  .summary:has(> :empty), .number:has(> :empty) { display: none; }
</style>
<div class="vol">
  <p class="number" data-ds-enter="left" data-ds-step="glide" data-ds-ease="paper" data-ds-distance="3" data-ds-order="1">{{ slots.number }}</p>
  <div>
    <h1 class="title" data-ds-enter="rise" data-ds-step="glide" data-ds-ease="paper" data-ds-distance="3" data-ds-order="2">{{ slots.title }}</h1>
    <p class="summary" data-ds-enter="fade" data-ds-step="ink" data-ds-ease="ink" data-ds-order="3">{{ slots.summary }}</p>
  </div>
</div>
