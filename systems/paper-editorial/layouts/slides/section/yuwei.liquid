{% comment %}
鱼尾 yuwei：刻本版心的写法。右边一条版心竖带（两条墨线，上下鱼尾，中间卷号横排直立的等高数字），标题竖排紧贴版心左侧（朱雀仿宋、title 档，单处不超过 16 字）；摘要横排在左下（lead ink-2）。左上大片留纸。
竖排只给标题；摘要横排。朱色：无。入场：标题自上而下洇出，摘要最后。
{% endcomment %}
<style>
  :scope {
    box-sizing: border-box;
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    padding: var(--ds-space-6) var(--ds-space-7);
    background: var(--ds-color-paper);
    color: var(--ds-color-ink);
    font-family: var(--ds-font-body);
    text-spacing-trim: trim-both;
  }
  :scope::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: .45;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .30 0 0 0 0 .24 0 0 0 0 .17 0 0 0 .16 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }
  p, h1, h2, ol, ul, li, figure, figcaption, blockquote { margin: 0; padding: 0; }
  p, li, blockquote { text-wrap: pretty; }
  h1, h2 { text-wrap: balance; }

  .page {
    display: grid;
    grid-template-columns: 1fr auto var(--ds-space-7);
    column-gap: var(--ds-space-6);
    height: 100%;
  }
  .summary {
    align-self: end;
    max-width: 16em;
    font-size: var(--ds-type-lead);
    letter-spacing: .04em;
    line-height: 1.7;
    color: var(--ds-color-ink-2);
    text-align: justify;
  }
  .title {
    writing-mode: vertical-rl;
    text-orientation: upright;
    word-spacing: -.75em;
    max-height: 6.6em;
    padding-top: var(--ds-space-5);
    text-wrap: balance;
    font-size: var(--ds-type-title);
    font-family: var(--ds-font-latin), var(--ds-font-cjk-display);
    font-weight: 400;
    letter-spacing: .14em;
    line-height: 1.3;
  }
  .banxin {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: var(--ds-space-3) 0;
    border-left: 1px solid var(--ds-color-ink);
    border-right: 1px solid var(--ds-color-ink);
  }
  .number {
    font-family: var(--ds-font-latin);
    font-size: var(--ds-type-lead);
    font-weight: 400;
    font-feature-settings: "lnum" 1, "tnum" 1;
    letter-spacing: .08em;
    color: var(--ds-color-ink-2);
  }
  .yuwei { width: 32px; fill: var(--ds-color-ink); }
  .summary:has(> :empty) { visibility: hidden; }
</style>
<div class="page">
  <p class="summary" data-ds-enter="fade" data-ds-step="ink" data-ds-ease="ink" data-ds-order="2">{{ slots.summary }}</p>
  <h1 class="title" data-ds-enter="fall" data-ds-step="glide" data-ds-ease="paper" data-ds-distance="3" data-ds-order="1">{{ slots.title }}</h1>
  <div class="banxin"><svg class="yuwei" viewBox="0 0 24 16" aria-hidden="true"><path d="M0 0H24V10L17 5.5L12 11.5L7 5.5L0 10Z"/></svg><p class="number">{{ slots.number }}</p><svg class="yuwei" viewBox="0 0 24 16" aria-hidden="true"><path d="M0 16H24V6L17 10.5L12 4.5L7 10.5L0 6Z"/></svg></div>
</div>
