{% comment %}
图版 tuban：一块四周留纸的图版。图居中偏上，外面一圈 1px rule 线框（像图版的压印边），不出血；图下一行图注：标题（宋体 600、lead）＋说明（body ink-2），中间一个全角空格，左对齐图框。
朱色：无（图里自带的一两处朱色已经够了）。入场：图版从下方轻轻升起（衬纸揭去的动作上线后改为揭去），图注随后洇出。
{% endcomment %}
<style>
  :scope {
    box-sizing: border-box;
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    padding: var(--ds-space-6) var(--ds-space-7);
    background: var(--ds-color-paper);
    color: var(--ds-color-ink);
    font-family: var(--ds-font-body);
    text-spacing-trim: trim-both;
  }
  :scope::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: .45;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .30 0 0 0 0 .24 0 0 0 0 .17 0 0 0 .16 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }
  p, h1, h2, ol, ul, li, figure, figcaption, blockquote { margin: 0; padding: 0; }
  p, li, blockquote { text-wrap: pretty; }
  h1, h2 { text-wrap: balance; }

  .plate {
    position: relative;
    width: 1344px;
    height: 756px;
    margin: 0 auto;
    padding: var(--ds-space-2);
    border: 1px solid var(--ds-color-rule);
    box-sizing: content-box;
  }
  .plate img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .cap {
    width: 1362px;
    margin: var(--ds-space-4) auto 0;
    display: flex;
    align-items: baseline;
    gap: var(--ds-space-4);
  }
  .heading {
    flex: none;
    font-family: var(--ds-font-cjk);
    font-size: var(--ds-type-lead);
    font-weight: 600;
    letter-spacing: .1em;
  }
  .caption { font-size: var(--ds-type-body); line-height: 1.6; color: var(--ds-color-ink-2); }
  .heading:has(> :empty), .caption:has(> :empty) { display: none; }
</style>
<figure>
  <div class="plate" data-ds-enter="rise" data-ds-step="glide" data-ds-ease="paper" data-ds-distance="3" data-ds-order="1">{{ slots.visual }}</div>
  <figcaption class="cap" data-ds-enter="fade" data-ds-step="ink" data-ds-ease="ink" data-ds-order="2"><span class="heading">{{ slots.heading }}</span><span class="caption">{{ slots.caption }}</span></figcaption>
</figure>
