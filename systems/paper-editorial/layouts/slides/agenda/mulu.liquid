{% comment %}
目录 mulu：左栏标题（朱雀仿宋、title 档），右栏逐行横排的目录，每行一条 rule-light 界栏，行首壹贰叁（楷书 ink-3，CSS 计数器 simp-chinese-formal），条目宋体 400、sub 档。页眉墨线空着，只作日志本的抬头。
朱色：无。入场：标题先出，条目自上而下错峰 line（70ms）。
{% endcomment %}
<style>
  :scope {
    box-sizing: border-box;
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    padding: var(--ds-space-6) var(--ds-space-7);
    background: var(--ds-color-paper);
    color: var(--ds-color-ink);
    font-family: var(--ds-font-body);
    text-spacing-trim: trim-both;
  }
  :scope::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: .45;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .30 0 0 0 0 .24 0 0 0 0 .17 0 0 0 .16 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }
  p, h1, h2, ol, ul, li, figure, figcaption, blockquote { margin: 0; padding: 0; }
  p, li, blockquote { text-wrap: pretty; }
  h1, h2 { text-wrap: balance; }

  .run { height: 0; border-bottom: 2px solid var(--ds-color-ink); }
  .body {
    display: grid;
    grid-template-columns: 5fr 9fr;
    column-gap: var(--ds-space-7);
    margin-top: var(--ds-space-8);
  }
  .heading {
    font-size: var(--ds-type-title);
    font-family: var(--ds-font-latin), var(--ds-font-cjk-display);
    font-weight: 400;
    letter-spacing: .04em;
    line-height: 1.2;
  }
  .items { list-style: none; counter-reset: n; border-top: 1px solid var(--ds-color-rule); }
  .items li {
    display: flex;
    align-items: baseline;
    gap: var(--ds-space-5);
    padding: var(--ds-space-3) 0;
    border-bottom: 1px solid var(--ds-color-rule-light);
    counter-increment: n;
    font-size: var(--ds-type-sub);
    letter-spacing: .04em;
    line-height: 1.3;
  }
  .items li::before {
    content: counter(n, simp-chinese-formal);
    flex: none;
    width: 1.4em;
    font-family: var(--ds-font-kai);
    font-size: var(--ds-type-note);
    color: var(--ds-color-ink-3);
  }
</style>
<div class="run"></div>
<div class="body">
  <h1 class="heading" data-ds-enter="rise" data-ds-step="glide" data-ds-ease="paper" data-ds-distance="3" data-ds-order="1">{{ slots.heading }}</h1>
  <ol class="items" data-ds-stagger="line">
    {% for item in slots.items %}<li data-ds-enter="fade" data-ds-step="ink" data-ds-ease="ink" data-ds-order="{{ forloop.index | plus: 1 }}">{{ item }}</li>
    {% endfor %}
  </ol>
</div>
