{% comment %}
大数 damu：数值 Source Serif 300 lnum，小红书 colossal、方形 display、公众号封面 title，占据画面上半；标签宋体 600 lead，标签下一道朱笔；context 宋体 400 body ink-2；heading 作页眉小字。
朱色：仅标签下划线。公众号封面改为左数右文两栏。
{% endcomment %}
<style>
  :scope {
    box-sizing: border-box;
    position: relative;
    width: 100%;
    height: 100%;
    padding: var(--ds-space-7) var(--ds-space-7);
    overflow: hidden;
    background: var(--ds-color-paper);
    color: var(--ds-color-ink);
    font-family: var(--ds-font-body);
  }
  :scope::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: .45;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .30 0 0 0 0 .24 0 0 0 0 .17 0 0 0 .16 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }
  .head {
    margin: 0;
    padding-bottom: var(--ds-space-3);
    border-bottom: 1px solid var(--ds-color-rule);
    font-size: var(--ds-type-caption);
    font-weight: 600;
    letter-spacing: .24em;
    color: var(--ds-color-ink-3);
  }
  .body {
    margin-top: var(--ds-space-10);
  }
  .value {
    margin: 0;
    font-family: var(--ds-font-latin);
    font-size: var(--ds-type-colossal);
    font-weight: 300;
    font-feature-settings: "lnum" 1;
    letter-spacing: -.02em;
    line-height: 1;
  }
  .lab {
    position: relative;
    display: inline-block;
    margin-top: var(--ds-space-7);
    padding-bottom: var(--ds-space-3);
  }
  .label {
    margin: 0;
    font-size: var(--ds-type-lead);
    font-weight: 600;
    letter-spacing: .12em;
    line-height: 1.4;
  }
  .stroke {
    position: absolute;
    left: -2%;
    bottom: 0;
    width: 104%;
    height: 22px;
    overflow: visible;
    fill: var(--ds-color-zhu);
  }
  .context {
    margin: var(--ds-space-5) 0 0;
    font-size: var(--ds-type-body);
    line-height: 1.7;
    color: var(--ds-color-ink-2);
  }
  .head:has(> :empty), .context:has(> :empty) { visibility: hidden; }
  @media (min-aspect-ratio: 9/10) and (max-aspect-ratio: 11/10) {
    .body { margin-top: var(--ds-space-10); }
    .value { font-size: var(--ds-type-display); }
    .lab { margin-top: var(--ds-space-6); }
  }
  @media (min-aspect-ratio: 2/1) {
    :scope { padding: var(--ds-space-5) var(--ds-space-7); }
    .body {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: var(--ds-space-7);
      align-items: center;
      margin-top: var(--ds-space-6);
    }
    .value { grid-row: 1 / 3; font-size: var(--ds-type-title); }
    .lab { margin-top: 0; justify-self: start; align-self: end; }
    .context { margin-top: var(--ds-space-3); align-self: start; max-width: 12.6em; }
    .stroke { height: 16px; }
  }
</style>
<p class="head">{{ slots.heading }}</p>
<div class="body">
  <p class="value">{{ slots.value }}</p>
  <div class="lab">
    <p class="label">{{ slots.label }}</p>
    <svg class="stroke" viewBox="0 0 400 24" preserveAspectRatio="none" aria-hidden="true"><path d="M2 14C60 8 140 10 214 8S340 8 398 10C344 14 270 17 204 16S70 19 2 14Z"/></svg>
  </div>
  <p class="context">{{ slots.context }}</p>
</div>
