{% comment %}
尺注 chizhu：一条横贯画面的尺寸标注线（两端短竖线加细箭头，墨 1px），数值（Source Serif 300 display 档，公众号封面 title 档）在中间断开处；标签与 context 放在右下角的标题栏里（细线框成的小表格，heading 在左格）。
朱色：heading 前一枚圈点。数值是单个槽位，单位 m 不能单独斜体。
{% endcomment %}
<style>
  :scope {
    box-sizing: border-box;
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--ds-color-paper);
    color: var(--ds-color-ink);
    font-family: var(--ds-font-body);
  }
  :scope::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: .45;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .30 0 0 0 0 .24 0 0 0 0 .17 0 0 0 .16 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }
  .dim {
    position: absolute;
    left: 72px;
    right: 72px;
    top: 440px;
    display: flex;
    align-items: center;
  }
  .arm {
    flex: 1;
    min-width: 0;
    height: 72px;
    overflow: visible;
  }
  .arm.r { transform: scaleX(-1); }
  .arm line, .arm path {
    stroke: var(--ds-color-ink);
    stroke-width: 1;
    fill: none;
  }
  .arm .tip { fill: var(--ds-color-ink); }
  .value {
    flex: none;
    margin: 0;
    padding: 0 var(--ds-space-5);
    font-family: var(--ds-font-latin);
    font-size: var(--ds-type-display);
    font-weight: 300;
    font-feature-settings: "lnum" 1;
    letter-spacing: -.02em;
    line-height: 1;
  }
  .plate {
    position: absolute;
    right: 72px;
    bottom: 72px;
    width: 780px;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 180px 1fr;
    grid-template-rows: auto auto;
    border: 1px solid var(--ds-color-ink);
  }
  .head {
    grid-row: 1 / 3;
    margin: 0;
    padding: var(--ds-space-4) var(--ds-space-3);
    border-right: 1px solid var(--ds-color-ink);
    font-size: var(--ds-type-caption);
    font-weight: 600;
    letter-spacing: .16em;
    line-height: 1.5;
    color: var(--ds-color-ink-3);
  }
  .head::before {
    content: "";
    display: block;
    width: 18px;
    height: 18px;
    margin-bottom: var(--ds-space-3);
    border-radius: 50%;
    background: var(--ds-color-zhu);
  }
  .label {
    margin: 0;
    padding: var(--ds-space-3) var(--ds-space-4);
    border-bottom: 1px solid var(--ds-color-rule);
    font-size: var(--ds-type-lead);
    font-weight: 600;
    letter-spacing: .12em;
    line-height: 1.4;
  }
  .context {
    margin: 0;
    padding: var(--ds-space-3) var(--ds-space-4);
    font-size: var(--ds-type-body);
    line-height: 1.5;
    color: var(--ds-color-ink-2);
  }
  .head:has(> :empty), .context:has(> :empty) { visibility: hidden; }
  @media (min-aspect-ratio: 9/10) and (max-aspect-ratio: 11/10) {
    .dim { top: 250px; }
  }
  @media (min-aspect-ratio: 2/1) {
    .dim { left: 48px; right: 48px; top: 36px; }
    .value { font-size: var(--ds-type-title); }
    .arm { height: 56px; }
    .plate { left: 48px; right: 48px; bottom: 36px; width: auto; grid-template-columns: 156px 1fr; }
    .head { padding: var(--ds-space-3) var(--ds-space-2) var(--ds-space-3) var(--ds-space-3); letter-spacing: .12em; }
    .label { padding: var(--ds-space-2) var(--ds-space-3); }
    .context { padding: var(--ds-space-2) var(--ds-space-3); }
  }
</style>
<div class="dim">
  <svg class="arm" aria-hidden="true"><line x1="0.5" y1="0" x2="0.5" y2="100%"/><line x1="0" y1="50%" x2="100%" y2="50%"/><path class="tip" d="M1 36L23 30V42Z"/></svg>
  <p class="value">{{ slots.value }}</p>
  <svg class="arm r" aria-hidden="true"><line x1="0.5" y1="0" x2="0.5" y2="100%"/><line x1="0" y1="50%" x2="100%" y2="50%"/><path class="tip" d="M1 36L23 30V42Z"/></svg>
</div>
<div class="plate">
  <p class="head">{{ slots.heading }}</p>
  <p class="label">{{ slots.label }}</p>
  <p class="context">{{ slots.context }}</p>
</div>
