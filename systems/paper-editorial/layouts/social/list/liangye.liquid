{% comment %}
两页 liangye：版心竖条（两条墨线夹一条，上下两个鱼尾，中间竖排 footnote 楷书朱色）把画面分成两页：右页竖排大标题（宋体 200 title 档），左页横排清单，编号用 01–07（Source Serif 300，lnum tnum），行间 rule-light 界栏。
公众号封面：版心改为左侧竖条，标题横排在其右，清单两栏（caption 档）。朱色：仅 footnote。
{% endcomment %}
<style>
  :scope {
    box-sizing: border-box;
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--ds-color-paper);
    color: var(--ds-color-ink);
    font-family: var(--ds-font-body);
  }
  :scope::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: .45;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .30 0 0 0 0 .24 0 0 0 0 .17 0 0 0 .16 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }
  .spine {
    position: absolute;
    top: 72px;
    bottom: 72px;
    left: 694px;
    width: 72px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: var(--ds-space-2) 0;
    border-left: 1px solid var(--ds-color-ink);
    border-right: 1px solid var(--ds-color-ink);
  }
  .yuwei {
    flex: none;
    width: 36px;
    height: 24px;
    fill: var(--ds-color-ink);
  }
  .yuwei.up { transform: scaleY(-1); }
  .foot {
    margin: 0;
    writing-mode: vertical-rl;
    text-orientation: upright;
    word-spacing: -.6em;
    font-family: var(--ds-font-kai);
    font-size: var(--ds-type-note);
    letter-spacing: .4em;
    color: var(--ds-color-zhu);
  }
  .foot:has(> :empty) { visibility: hidden; }
  .heading {
    position: absolute;
    top: 144px;
    right: 96px;
    margin: 0;
    writing-mode: vertical-rl;
    font-size: var(--ds-type-title);
    font-weight: 200;
    letter-spacing: .08em;
    line-height: 1.3;
  }
  .items {
    position: absolute;
    top: 144px;
    left: 72px;
    width: 570px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: n;
    border-top: 1px solid var(--ds-color-rule-light);
  }
  .items li {
    display: grid;
    grid-template-columns: 84px 1fr;
    align-items: baseline;
    padding: var(--ds-space-5) 0;
    border-bottom: 1px solid var(--ds-color-rule-light);
    font-size: var(--ds-type-body);
    font-weight: 400;
    line-height: 1.5;
    counter-increment: n;
  }
  .items li::before {
    content: counter(n, decimal-leading-zero);
    font-family: var(--ds-font-latin);
    font-size: var(--ds-type-lead);
    font-weight: 300;
    font-feature-settings: "lnum" 1, "tnum" 1;
    color: var(--ds-color-ink-3);
  }
  @media (min-aspect-ratio: 9/10) and (max-aspect-ratio: 11/10) {
    .heading { top: 84px; right: 90px; letter-spacing: .04em; line-height: 1.2; }
    .items { top: 108px; }
    .items li { padding: var(--ds-space-3) 0; }
  }
  @media (min-aspect-ratio: 2/1) {
    .spine { top: 30px; bottom: 30px; left: 36px; }
    .foot { text-orientation: mixed; font-size: var(--ds-type-caption); letter-spacing: .1em; }
    .heading { top: 30px; left: 144px; right: auto; writing-mode: horizontal-tb; font-size: var(--ds-type-sub); letter-spacing: .08em; line-height: 1.3; }
    .items { top: 114px; left: 144px; width: 726px; display: grid; grid-template-columns: 1fr 1fr; grid-auto-flow: column; grid-template-rows: repeat(4, auto); column-gap: var(--ds-space-5); border-top: 0; }
    .items li { grid-template-columns: 40px 1fr; padding: var(--ds-space-2) 0 var(--ds-space-1); font-size: var(--ds-type-caption); }
    .items li::before { font-size: var(--ds-type-caption); }
  }
</style>
<div class="spine">
  <svg class="yuwei" viewBox="0 0 24 16" aria-hidden="true"><path d="M0 0H24V10L17 5.5L12 11.5L7 5.5L0 10Z"/></svg>
  <p class="foot">{{ slots.footnote }}</p>
  <svg class="yuwei up" viewBox="0 0 24 16" aria-hidden="true"><path d="M0 0H24V10L17 5.5L12 11.5L7 5.5L0 10Z"/></svg>
</div>
<h1 class="heading">{{ slots.heading }}</h1>
<ol class="items">
  {% for item in slots.items %}<li>{{ item }}</li>
  {% endfor %}
</ol>
