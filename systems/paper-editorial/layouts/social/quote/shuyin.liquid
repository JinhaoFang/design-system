{% comment %}
竖引 shuyin：金句竖排（宋体 200 head 档，两列，靠右起排），落款楷书朱色竖排在其左下，品牌小字横排在底边，不加边栏。
方形画幅字号降到 sub 以保持两列；公众号封面改横排。朱色：仅落款。竖排数字直立（text-orientation: upright，宋体字形，每个数字一格），列高（小红书 1110、方形 760）定在「250」之后、「万」之前换列，数字不被拆开。
{% endcomment %}
<style>
  :scope {
    box-sizing: border-box;
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--ds-color-paper);
    color: var(--ds-color-ink);
    font-family: var(--ds-font-body);
  }
  :scope::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: .45;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .30 0 0 0 0 .24 0 0 0 0 .17 0 0 0 .16 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }
  .stage {
    position: absolute;
    top: 120px;
    right: 150px;
    height: 1110px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--ds-space-8);
    writing-mode: vertical-rl;
    text-orientation: upright;
    word-spacing: -.75em;
    font-family: var(--ds-font-cjk);
  }
  .quote {
    flex: none;
    align-self: flex-start;
    margin: 0;
    height: 1110px;
    font-size: var(--ds-type-head);
    font-weight: 200;
    letter-spacing: .02em;
    line-height: 2.1;
  }
  .by {
    flex: none;
    margin: 0;
    font-family: var(--ds-font-kai);
    font-size: var(--ds-type-body);
    letter-spacing: .24em;
    line-height: 1.6;
    color: var(--ds-color-zhu);
  }
  .foot {
    position: absolute;
    left: 72px;
    right: 72px;
    bottom: 72px;
    margin: 0;
    padding-top: var(--ds-space-3);
    border-top: 1px solid var(--ds-color-rule-light);
    font-size: var(--ds-type-caption);
    letter-spacing: .16em;
    color: var(--ds-color-ink-3);
  }
  .by:has(> :empty), .foot:has(> :empty) { visibility: hidden; }
  @media (min-aspect-ratio: 9/10) and (max-aspect-ratio: 11/10) {
    .stage { top: 110px; right: 150px; height: 800px; }
    .quote { height: 760px; font-size: var(--ds-type-sub); line-height: 2.3; letter-spacing: .02em; }
  }
  @media (min-aspect-ratio: 2/1) {
    .stage { top: 50px; left: 48px; right: 48px; height: auto; flex-direction: column; align-items: flex-start; gap: var(--ds-space-4); writing-mode: horizontal-tb; }
    .quote { height: auto; font-size: var(--ds-type-sub); letter-spacing: 0; line-height: 1.55; }
    .by { align-self: flex-end; letter-spacing: .16em; }
    .foot { left: 48px; right: 48px; bottom: 24px; padding-top: var(--ds-space-2); }
  }
</style>
<div class="stage">
  <p class="quote">{{ slots.quote }}</p>
  <p class="by">{{ slots.by }}</p>
</div>
<p class="foot">{{ slots.brand }}</p>
