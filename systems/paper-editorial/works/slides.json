    { "unit": "process", "layout": "jishi", "content": { "heading": { "ref": "process.heading" }, "steps": { "ref": "process.steps" }, "stepNotes": { "ref": "process.stepNotes" } } },
    { "custom": { "file": "fragments/shouguang-ye.html" }, "serves": "全册的高光：首光那一页日志。「250 万年」下一道朱笔，右边是首光那晚的北天星图，仙女星系用朱圈指认" },
    { "unit": "data", "layout": "damu", "content": { "heading": { "ref": "data.booking.heading" }, "value": { "ref": "data.booking.value" }, "label": { "ref": "data.booking.label" }, "context": { "ref": "data.booking.context" }, "source": { "ref": "data.booking.source" } } },
    { "unit": "closing", "layout": "luokuan", "content": { "headline": { "ref": "closing.headline" }, "contact": { "ref": "closing.contact" }, "action": { "ref": "closing.action" } } }
  ]
