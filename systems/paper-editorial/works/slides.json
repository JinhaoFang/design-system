{
  "system": "paper-editorial",
  "carrier": "slides",
  "concept": "观测日志·卷一：整份幻灯片是一册天文台的观测日志。扉页是日志本翻开的第一页，两个章节页是日志的分卷（大号卷号压在一条墨线上），每一页都像从同一本里翻出来：墨线抬头、细笔大字、界栏和工程图式的尺寸标注。全册只在两处动朱笔：首光那一页，「250 万年」下一道；名额那一页，「首批观测夜名额」下一道。最后一张预约券收尾。",
  "sequence": [
    { "unit": "cover", "layout": "rizhi", "content": { "title": { "ref": "cover.title" }, "subtitle": { "ref": "cover.subtitle" }, "presenter": { "ref": "cover.presenter" }, "date": { "ref": "cover.date" } } },
    { "unit": "agenda", "layout": "mulu", "content": { "heading": { "ref": "agenda.heading" }, "items": { "ref": "agenda.items" } } },
    { "unit": "section", "layout": "fenjuan", "content": { "number": { "ref": "section.why.number" }, "title": { "ref": "section.why.title" }, "summary": { "ref": "section.why.summary" } } },
    { "unit": "statement", "layout": "duanyu", "content": { "claim": { "ref": "statement.old.claim" }, "support": { "ref": "statement.old.support" }, "source": { "ref": "statement.old.source" } } },
    { "unit": "data", "layout": "chizhu", "content": { "heading": { "ref": "data.aperture.heading" }, "value": { "ref": "data.aperture.value" }, "label": { "ref": "data.aperture.label" }, "context": { "ref": "data.aperture.context" }, "source": { "ref": "data.aperture.source" } } },
    { "unit": "compare", "layout": "liangye", "content": { "heading": { "ref": "compare.heading" }, "leftTitle": { "ref": "compare.leftTitle" }, "leftPoints": { "ref": "compare.leftPoints" }, "rightTitle": { "ref": "compare.rightTitle" }, "rightPoints": { "ref": "compare.rightPoints" }, "verdict": { "ref": "compare.verdict" } } },
    { "unit": "section", "layout": "fenjuan", "content": { "number": { "ref": "section.build.number" }, "title": { "ref": "section.build.title" }, "summary": { "ref": "section.build.summary" } } },
