<style>
:scope { position:relative; box-sizing:border-box; isolation:isolate; padding:var(--ds-space-9) var(--ds-space-8); background:var(--ds-color-paper); color:var(--ds-color-blue); font-family:var(--ds-font-body); font-size:var(--ds-type-body); line-height:1.7; }
:scope * { box-sizing:border-box; }
h1,h2,h3,p,ul,ol,li,figure,blockquote,dl,dd,dt { margin:0; padding:0; }
ul,ol { list-style:none; }
p,blockquote,figcaption { text-wrap:pretty; }
a { color:inherit; text-underline-offset:.25em; }
a:focus-visible { outline:2px solid var(--ds-color-blue); outline-offset:var(--ds-space-1); }
.wrap { max-width:1240px; margin:0 auto; }
.kicker { font-size:var(--ds-type-note); border-top:6px solid var(--ds-color-blue); padding-top:var(--ds-space-3); margin-bottom:var(--ds-space-6); }
.heading { font-size:var(--ds-type-head); line-height:1.35; font-weight:700; text-wrap:balance; }
.lead { font-size:var(--ds-type-lead); max-width:40em; text-wrap:pretty; }
.body { max-width:40em; text-wrap:pretty; }
.stack { display:grid; gap:var(--ds-space-6); }
.split { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:var(--ds-space-8); align-items:center; }
figure img { display:block; width:100%; height:auto; }
.stripe { height:var(--ds-space-3); margin:var(--ds-space-6) 0; background:repeating-linear-gradient(135deg,var(--ds-color-pink) 0 var(--ds-space-1),transparent var(--ds-space-1) var(--ds-space-2)); }
.rows { border-top:2px solid var(--ds-color-blue); }
.row { display:grid; grid-template-columns:var(--ds-space-7) minmax(0,1fr) minmax(0,2fr); gap:var(--ds-space-5); padding:var(--ds-space-5) 0; border-bottom:2px solid var(--ds-color-blue); align-items:baseline; }
.num { font-family:var(--ds-font-num); font-variant-numeric:tabular-nums lining-nums; }
.row h3 { font-size:var(--ds-type-lead); font-weight:700; }
.note { font-size:var(--ds-type-note); }
.stamp { display:grid; place-content:center; text-align:center; width:var(--ds-space-10); height:var(--ds-space-10); border-radius:var(--ds-radius-disc); background:var(--ds-color-pink); color:var(--ds-color-purple); font-weight:700; font-size:var(--ds-type-lead); text-decoration:none; }
.ticket { display:inline-block; width:fit-content; padding:var(--ds-space-4) var(--ds-space-6); border:2px dashed var(--ds-color-blue); background:var(--ds-color-paper-deep); font-size:var(--ds-type-lead); font-weight:700; text-decoration:none; }
.logos { display:flex; flex-wrap:wrap; gap:var(--ds-space-5); align-items:center; }
.logos img { width:var(--ds-space-10); height:auto; }
blockquote { font-size:var(--ds-type-sub); line-height:1.7; max-width:30em; }
.cite { font-size:var(--ds-type-body); margin-top:var(--ds-space-5); }
@media(max-width:860px) {
 :scope { padding:var(--ds-space-8) var(--ds-space-5); }
 .split { grid-template-columns:1fr; gap:var(--ds-space-7); }
 .heading { font-size:var(--ds-type-sub); }
 .lead { font-size:var(--ds-type-body); }
 .row { grid-template-columns:var(--ds-space-5) minmax(0,1fr); gap:var(--ds-space-3); }
 .row p { grid-column:1 / -1; }
 blockquote { font-size:var(--ds-type-lead); }
}
.points li{border-bottom:2px solid var(--ds-color-blue);padding:var(--ds-space-5) 0;font-size:var(--ds-type-lead);}</style><div class="wrap"><h2 class="heading" data-ds-enter="rise" data-ds-order="0" data-ds-step="feed" data-ds-ease="feed" data-ds-distance="3">{{ slots.heading }}</h2><div class="stripe" aria-hidden="true"></div><div class="split"><p class="lead" data-ds-enter="rise" data-ds-order="1" data-ds-step="feed" data-ds-ease="feed" data-ds-distance="3">{{ slots.body }}</p><ul class="points">{% for point in slots.points %}<li data-ds-enter="left" data-ds-order="{{ forloop.index0 }}" data-ds-step="feed" data-ds-ease="feed" data-ds-distance="3">{{ point }}</li>{% endfor %}</ul></div></div>
