{% comment %}
网点 wangdian：一枚大的两色网点圆（内联 SVG：蓝网点 15°、粉网点 75° 叠印，外圈一道蓝环）占画面上部，数值 Space Grotesk 粗体 display 档横排在圆的右下；
标签、说明在下方横排，heading 作页眉。不错版。公众号封面圆在左，文字在右。
{% endcomment %}
<style>
  :scope {
    box-sizing: border-box;
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--ds-color-paper);
    color: var(--ds-color-blue);
    font-family: var(--ds-font-body);
    line-height: 1.5;
  }
  :scope::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 9;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: var(--ds-grain-max);
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.95' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .2  0 0 0 0 .1  0 0 0 0 .44  0 0 0 1.1 -.2'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }
  p, h1, h2, h3, ul, ol, li, figure, blockquote { margin: 0; padding: 0; list-style: none; text-wrap: pretty; }
  .mis { position: relative; display: block; }
  .mis > .ink { position: relative; display: block; mix-blend-mode: multiply; }
  .mis > .pl { position: absolute; left: var(--ds-space-1); top: calc(var(--ds-space-1) * -0.5); width: 100%; height: 100%; pointer-events: none; mix-blend-mode: multiply; }
  .mis > .pl::before { content: attr(data-mis); display: block; color: var(--ds-color-pink); }
  .num { font-family: var(--ds-font-num); font-variant-numeric: tabular-nums lining-nums; }
  .stamp { box-sizing: border-box; display: grid; place-items: center; border-radius: var(--ds-radius-disc); background: var(--ds-color-pink); color: var(--ds-color-purple); font-family: var(--ds-font-display); line-height: 1.05; text-align: center; text-wrap: balance; mix-blend-mode: multiply; }
  .band { background-image: repeating-linear-gradient(-45deg, var(--ds-color-pink) 0 var(--ds-space-1), transparent var(--ds-space-1) var(--ds-space-2)); mix-blend-mode: multiply; }
  .dots { background-image: radial-gradient(circle, var(--ds-color-pink) 0 36%, transparent 38%); background-size: var(--ds-space-2) var(--ds-space-2); mix-blend-mode: multiply; }
  .dots-blue { background-image: radial-gradient(circle, var(--ds-color-blue) 0 30%, transparent 32%); background-size: var(--ds-space-2) var(--ds-space-2); mix-blend-mode: multiply; }

  :scope { padding: var(--ds-space-7) var(--ds-space-6); display: flex; flex-direction: column; }
  .heading { font-family: var(--ds-font-cjk-strong); font-weight: 700; font-size: var(--ds-type-note); letter-spacing: .08em; }
  .fig { position: relative; margin-top: var(--ds-space-5); display: flex; align-items: flex-end; }
  .fig svg { width: 50%; height: auto; display: block; flex: none; }
  .value { position: relative; margin-left: var(--ds-space-4); padding-bottom: var(--ds-space-4); font-family: var(--ds-font-num-bold); font-weight: 700; font-size: var(--ds-type-display); line-height: 1; mix-blend-mode: multiply; font-variant-numeric: lining-nums; }
  .label { margin-top: auto; font-family: var(--ds-font-cjk-strong); font-weight: 700; font-size: var(--ds-type-sub); line-height: 1.25; }
  .context { margin-top: var(--ds-space-3); font-size: var(--ds-type-lead); line-height: 1.45; }
  @media (min-aspect-ratio: 9/10) and (max-aspect-ratio: 11/10) { .fig svg { width: 46%; } .label { font-size: var(--ds-type-lead); } .context { font-size: var(--ds-type-body); } }
  @media (min-aspect-ratio: 2/1) {
    :scope { padding: var(--ds-space-3) var(--ds-space-6); display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto 1fr; column-gap: var(--ds-space-5); }
    .fig { grid-row: 1 / 4; margin-top: 0; height: 100%; }
    .fig svg { width: auto; height: 100%; }
    .value { font-size: var(--ds-type-head); padding-bottom: var(--ds-space-2); transform: translateX(calc(var(--ds-space-7) * -1)); }
    .heading { font-size: var(--ds-type-caption); grid-column: 2; }
    .label { grid-column: 2; margin-top: var(--ds-space-3); font-size: var(--ds-type-body); }
    .context { grid-column: 2; font-size: var(--ds-type-caption); margin-top: var(--ds-space-1); }
  }
</style>
<p class="heading" data-ds-enter="fade" data-ds-order="0">{{ slots.heading }}</p>
<div class="fig">
  <svg viewBox="-110 -110 220 220" aria-hidden="true" data-ds-enter="fade" data-ds-step="feed" data-ds-order="1"><defs><pattern id="wd-b" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(15)"><circle cx="3" cy="3" r="1.9" fill="var(--ds-color-blue)"/></pattern><pattern id="wd-p" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(75)"><circle cx="3" cy="3" r="2.2" fill="var(--ds-color-pink)"/></pattern></defs><g style="mix-blend-mode:multiply"><circle r="100" fill="url(#wd-b)"/></g><g style="mix-blend-mode:multiply" transform="translate(3 -1.5)"><circle r="62" fill="url(#wd-p)"/></g><circle r="104" fill="none" stroke="var(--ds-color-blue)" stroke-width="4"/></svg>
  <p class="value" data-ds-enter="rise" data-ds-step="feed" data-ds-ease="feed" data-ds-distance="2" data-ds-order="2">{{ slots.value }}</p>
</div>
<p class="label" data-ds-enter="fade" data-ds-order="3">{{ slots.label }}</p>
<p class="context" data-ds-enter="fade" data-ds-order="4">{{ slots.context }}</p>
