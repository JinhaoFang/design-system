{% comment %}
大数 dashu：数值用 Space Grotesk 粗体 poster 档（方形 display、公众号封面 title），粉版按体系常量错开（全画面唯一的错版）；页眉 heading 压一道 6px 蓝线；
标签思源黑体粗 sub 档，说明 lead。右上一枚粉色网点圆盘作背景装饰，与数字相叠成紫。公众号封面左数右文。
{% endcomment %}
<style>
  :scope {
    box-sizing: border-box;
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--ds-color-paper);
    color: var(--ds-color-blue);
    font-family: var(--ds-font-body);
    line-height: 1.5;
  }
  :scope::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 9;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: var(--ds-grain-max);
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.95' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .2  0 0 0 0 .1  0 0 0 0 .44  0 0 0 1.1 -.2'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }
  p, h1, h2, h3, ul, ol, li, figure, blockquote { margin: 0; padding: 0; list-style: none; text-wrap: pretty; }
  .mis { position: relative; display: block; }
  .mis > .ink { position: relative; display: block; mix-blend-mode: multiply; }
  .mis > .pl { position: absolute; left: var(--ds-space-1); top: calc(var(--ds-space-1) * -0.5); width: 100%; height: 100%; pointer-events: none; mix-blend-mode: multiply; }
  .mis > .pl::before { content: attr(data-mis); display: block; color: var(--ds-color-pink); }
  .num { font-family: var(--ds-font-num); font-variant-numeric: tabular-nums lining-nums; }
  .stamp { box-sizing: border-box; display: grid; place-items: center; border-radius: var(--ds-radius-disc); background: var(--ds-color-pink); color: var(--ds-color-purple); font-family: var(--ds-font-display); line-height: 1.05; text-align: center; text-wrap: balance; mix-blend-mode: multiply; }
  .band { background-image: repeating-linear-gradient(-45deg, var(--ds-color-pink) 0 var(--ds-space-1), transparent var(--ds-space-1) var(--ds-space-2)); mix-blend-mode: multiply; }
  .dots { background-image: radial-gradient(circle, var(--ds-color-pink) 0 36%, transparent 38%); background-size: var(--ds-space-2) var(--ds-space-2); mix-blend-mode: multiply; }
  .dots-blue { background-image: radial-gradient(circle, var(--ds-color-blue) 0 30%, transparent 32%); background-size: var(--ds-space-2) var(--ds-space-2); mix-blend-mode: multiply; }

  :scope { padding: var(--ds-space-7) var(--ds-space-6); display: flex; flex-direction: column; }
  .disc { position: absolute; right: calc(var(--ds-space-7) * -1); top: var(--ds-space-8); width: 58%; height: auto; mix-blend-mode: multiply; }
  .heading { position: relative; padding-bottom: var(--ds-space-3); border-bottom: 6px solid var(--ds-color-blue); font-family: var(--ds-font-cjk-strong); font-weight: 700; font-size: var(--ds-type-note); letter-spacing: .08em; }
  .value { margin-top: var(--ds-space-9); font-family: var(--ds-font-num-bold); font-weight: 700; font-size: var(--ds-type-poster); line-height: .9; letter-spacing: -.03em; font-variant-numeric: lining-nums; }
  .label { position: relative; margin-top: auto; font-family: var(--ds-font-cjk-strong); font-weight: 700; font-size: var(--ds-type-sub); line-height: 1.25; }
  .context { position: relative; margin-top: var(--ds-space-3); font-size: var(--ds-type-lead); line-height: 1.45; max-width: 20em; }
  @media (min-aspect-ratio: 9/10) and (max-aspect-ratio: 11/10) { .value { font-size: var(--ds-type-display); margin-top: var(--ds-space-8); } .label { font-size: var(--ds-type-lead); } .context { font-size: var(--ds-type-body); } }
  @media (min-aspect-ratio: 2/1) {
    :scope { padding: var(--ds-space-4) var(--ds-space-6); display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto 1fr; column-gap: var(--ds-space-6); }
    .heading { grid-column: 1 / 3; font-size: var(--ds-type-caption); padding-bottom: var(--ds-space-2); }
    .value { grid-row: 2; margin-top: 0; align-self: center; font-size: var(--ds-type-title); }
    .text { grid-row: 2; align-self: center; }
    .label { font-size: var(--ds-type-body); }
    .context { font-size: var(--ds-type-caption); }
    .disc { width: 26%; top: var(--ds-space-4); right: var(--ds-space-3); }
  }
  .text { display: contents; }
  @media (min-aspect-ratio: 2/1) { .text { display: block; } }
</style>
<svg class="disc" viewBox="-100 -100 200 200" aria-hidden="true"><defs><pattern id="ds-dot" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(75)"><circle cx="3.5" cy="3.5" r="2.6" fill="var(--ds-color-pink)"/></pattern></defs><circle r="100" fill="url(#ds-dot)"/></svg>
<p class="heading" data-ds-enter="fade" data-ds-order="0">{{ slots.heading }}</p>
<p class="mis value" data-ds-enter="rise" data-ds-step="feed" data-ds-ease="feed" data-ds-distance="2" data-ds-order="1"><span class="pl" data-mis="{{ slots.value.html | strip_html }}" data-ds-enter="left" data-ds-step="set" data-ds-ease="set" data-ds-distance="3" data-ds-wait="feed" data-ds-order="9" aria-hidden="true"></span><span class="ink">{{ slots.value }}</span></p>
<div class="text"><p class="label" data-ds-enter="fade" data-ds-order="2">{{ slots.label }}</p><p class="context" data-ds-enter="fade" data-ds-order="3">{{ slots.context }}</p></div>
