{% comment %}
块印 kuaiyin：一块满版的蓝色实地，标题在蓝版上反白（思源黑体粗 title 档，方形 head 档）；粉版只印标题，按体系常量错开压在反白字上：字成粉色，错开处露出一线纸色、压在蓝上成紫——这就是错版。
眉题、副题、品牌在实地下方的纸面上横排。公众号封面实地占左边六成。
{% endcomment %}
<style>
  :scope {
    box-sizing: border-box;
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--ds-color-paper);
    color: var(--ds-color-blue);
    font-family: var(--ds-font-body);
    line-height: 1.5;
  }
  :scope::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 9;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: var(--ds-grain-max);
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.95' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .2  0 0 0 0 .1  0 0 0 0 .44  0 0 0 1.1 -.2'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }
  p, h1, h2, h3, ul, ol, li, figure, blockquote { margin: 0; padding: 0; list-style: none; text-wrap: pretty; }
  .mis { position: relative; display: block; }
  .mis > .ink { position: relative; display: block; mix-blend-mode: multiply; }
  .mis > .pl { position: absolute; left: var(--ds-space-1); top: calc(var(--ds-space-1) * -0.5); width: 100%; height: 100%; pointer-events: none; mix-blend-mode: multiply; }
  .mis > .pl::before { content: attr(data-mis); display: block; color: var(--ds-color-pink); }
  .num { font-family: var(--ds-font-num); font-variant-numeric: tabular-nums lining-nums; }
  .stamp { box-sizing: border-box; display: grid; place-items: center; border-radius: var(--ds-radius-disc); background: var(--ds-color-pink); color: var(--ds-color-purple); font-family: var(--ds-font-display); line-height: 1.05; text-align: center; text-wrap: balance; mix-blend-mode: multiply; }
  .band { background-image: repeating-linear-gradient(-45deg, var(--ds-color-pink) 0 var(--ds-space-1), transparent var(--ds-space-1) var(--ds-space-2)); mix-blend-mode: multiply; }
  .dots { background-image: radial-gradient(circle, var(--ds-color-pink) 0 36%, transparent 38%); background-size: var(--ds-space-2) var(--ds-space-2); mix-blend-mode: multiply; }
  .dots-blue { background-image: radial-gradient(circle, var(--ds-color-blue) 0 30%, transparent 32%); background-size: var(--ds-space-2) var(--ds-space-2); mix-blend-mode: multiply; }

  :scope { padding: var(--ds-space-6); display: grid; grid-template-rows: 1fr auto; row-gap: var(--ds-space-6); }
  .block { position: relative; }
  .solid { position: relative; height: 100%; box-sizing: border-box; padding: var(--ds-space-7) var(--ds-space-6); display: flex; flex-direction: column; justify-content: space-between; background: var(--ds-color-blue); color: var(--ds-color-paper); mix-blend-mode: multiply; }
  .kicker { font-family: var(--ds-font-num); font-size: var(--ds-type-note); letter-spacing: .1em; }
  .title { font-family: var(--ds-font-cjk-strong); font-weight: 700; font-size: var(--ds-type-title); line-height: 1.12; text-wrap: balance; }
  .solid .mis > .ink { mix-blend-mode: normal; }
  .solid .mis > .pl { z-index: 1; }
  .foot { display: flex; justify-content: space-between; align-items: end; column-gap: var(--ds-space-5); }
  .subtitle { font-size: var(--ds-type-lead); line-height: 1.45; max-width: 16em; }
  .brand { font-family: var(--ds-font-cjk-strong); font-weight: 700; font-size: var(--ds-type-note); letter-spacing: .08em; white-space: nowrap; }
  @media (min-aspect-ratio: 9/10) and (max-aspect-ratio: 11/10) { .title { font-size: var(--ds-type-head); } .subtitle { font-size: var(--ds-type-body); } }
  @media (min-aspect-ratio: 2/1) {
    :scope { padding: var(--ds-space-4); grid-template-rows: 1fr; grid-template-columns: 3fr 2fr; column-gap: var(--ds-space-5); }
    .solid { padding: var(--ds-space-4); }
    .title { font-size: var(--ds-type-sub); }
    .foot { flex-direction: column; align-items: start; justify-content: space-between; }
    .subtitle { font-size: var(--ds-type-note); }
  }
</style>
<div class="block" data-ds-enter="left" data-ds-step="feed" data-ds-ease="feed" data-ds-order="0">
  <div class="solid"><p class="kicker">{{ slots.kicker }}</p><h1 class="mis title"><span class="pl" data-mis="{{ slots.title.html | strip_html }}" data-ds-enter="left" data-ds-step="set" data-ds-ease="set" data-ds-distance="3" data-ds-wait="feed" data-ds-order="9" aria-hidden="true"></span><span class="ink">{{ slots.title }}</span></h1></div>
</div>
<div class="foot" data-ds-enter="fade" data-ds-order="1"><p class="subtitle">{{ slots.subtitle }}</p><p class="brand">{{ slots.brand }}</p></div>
