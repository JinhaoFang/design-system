{% comment %}
海报 haibao：双色海报的标题型。页眉一道 6px 蓝线，眉题在左、品牌在右；标题用庆科黄油体 display 档（方形 title 档），按平衡折行，粉版按体系常量错开（错版，全画面唯一一处）；
副题思源黑体粗 sub 档紧跟标题，底部一条粉斜纹带收住画面。一枚粉色网点圆盘从右下出血，与蓝字相叠处是紫。公众号封面改为标题一行在左、副题在右。
{% endcomment %}
<style>
  :scope {
    box-sizing: border-box;
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--ds-color-paper);
    color: var(--ds-color-blue);
    font-family: var(--ds-font-body);
    line-height: 1.5;
  }
  :scope::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 9;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: var(--ds-grain-max);
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.95' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .2  0 0 0 0 .1  0 0 0 0 .44  0 0 0 1.1 -.2'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }
  p, h1, h2, h3, ul, ol, li, figure, blockquote { margin: 0; padding: 0; list-style: none; text-wrap: pretty; }
  .mis { position: relative; display: block; }
  .mis > .ink { position: relative; display: block; mix-blend-mode: multiply; }
  .mis > .pl { position: absolute; left: var(--ds-space-1); top: calc(var(--ds-space-1) * -0.5); width: 100%; height: 100%; pointer-events: none; mix-blend-mode: multiply; }
  .mis > .pl::before { content: attr(data-mis); display: block; color: var(--ds-color-pink); }
  .num { font-family: var(--ds-font-num); font-variant-numeric: tabular-nums lining-nums; }
  .stamp { box-sizing: border-box; display: grid; place-items: center; border-radius: var(--ds-radius-disc); background: var(--ds-color-pink); color: var(--ds-color-purple); font-family: var(--ds-font-display); line-height: 1.05; text-align: center; text-wrap: balance; mix-blend-mode: multiply; }
  .band { background-image: repeating-linear-gradient(-45deg, var(--ds-color-pink) 0 var(--ds-space-1), transparent var(--ds-space-1) var(--ds-space-2)); mix-blend-mode: multiply; }
  .dots { background-image: radial-gradient(circle, var(--ds-color-pink) 0 36%, transparent 38%); background-size: var(--ds-space-2) var(--ds-space-2); mix-blend-mode: multiply; }
  .dots-blue { background-image: radial-gradient(circle, var(--ds-color-blue) 0 30%, transparent 32%); background-size: var(--ds-space-2) var(--ds-space-2); mix-blend-mode: multiply; }

  :scope { padding: var(--ds-space-7) var(--ds-space-6) var(--ds-space-7); display: flex; flex-direction: column; }
  .head { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: var(--ds-space-3); border-bottom: 6px solid var(--ds-color-blue); font-family: var(--ds-font-cjk-strong); font-weight: 700; font-size: var(--ds-type-note); letter-spacing: .08em; }
  .disc { position: absolute; right: calc(var(--ds-space-8) * -1); bottom: var(--ds-space-8); width: 68%; height: auto; mix-blend-mode: multiply; }
  .title { position: relative; margin-top: var(--ds-space-7); font-family: var(--ds-font-display); font-weight: 400; font-size: var(--ds-type-display); line-height: 1.04; text-wrap: balance; }
  .subtitle { position: relative; margin-top: var(--ds-space-7); font-size: var(--ds-type-sub); line-height: 1.4; font-weight: 700; font-family: var(--ds-font-cjk-strong); max-width: 16em; text-wrap: balance; }
  .band { margin-top: auto; height: var(--ds-space-5); }
  @media (min-aspect-ratio: 9/10) and (max-aspect-ratio: 11/10) { .subtitle { font-size: var(--ds-type-lead); margin-top: var(--ds-space-5); } .band { height: var(--ds-space-4); } }
  @media (min-aspect-ratio: 9/10) and (max-aspect-ratio: 11/10) { .title { font-size: var(--ds-type-title); margin-top: var(--ds-space-6); } .disc { width: 50%; bottom: var(--ds-space-6); } }
  @media (min-aspect-ratio: 2/1) {
    :scope { padding: var(--ds-space-4) var(--ds-space-6); }
    .title { margin-top: var(--ds-space-4); font-size: var(--ds-type-head); }
    .subtitle { font-size: var(--ds-type-body); margin-top: var(--ds-space-3); }
    .band { height: var(--ds-space-2); }
    .disc { width: 30%; bottom: auto; top: var(--ds-space-4); right: var(--ds-space-4); }
  }
</style>
<svg class="disc" viewBox="-100 -100 200 200" aria-hidden="true"><defs><pattern id="hb-dot" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(75)"><circle cx="3.5" cy="3.5" r="2.6" fill="var(--ds-color-pink)"/></pattern></defs><circle r="100" fill="url(#hb-dot)"/></svg>
<div class="head" data-ds-enter="fade" data-ds-order="0"><p>{{ slots.kicker }}</p><p>{{ slots.brand }}</p></div>
<h1 class="mis title" data-ds-enter="rise" data-ds-step="feed" data-ds-ease="feed" data-ds-distance="2" data-ds-order="1"><span class="pl" data-mis="{{ slots.title.html | strip_html }}" data-ds-enter="left" data-ds-step="set" data-ds-ease="set" data-ds-distance="3" data-ds-wait="feed" data-ds-order="9" aria-hidden="true"></span><span class="ink">{{ slots.title }}</span></h1>
<p class="subtitle" data-ds-enter="fade" data-ds-order="2">{{ slots.subtitle }}</p>
<div class="band" aria-hidden="true"></div>
