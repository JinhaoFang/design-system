{% comment %}
票根 piaogen：清单印成一张票。票面是 paper-deep 实地，左边一列打孔（伪元素，网点圆孔）；标题思源黑体粗 head 档（方形 sub 档），条目逐行横排、行间蓝色细线；
右侧票根用虚线隔开，竖着放条目数（Space Grotesk display 档）与「项」，脚注在票根底部。不错版。公众号封面票根缩窄。
{% endcomment %}
<style>
  :scope {
    box-sizing: border-box;
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--ds-color-paper);
    color: var(--ds-color-blue);
    font-family: var(--ds-font-body);
    line-height: 1.5;
  }
  :scope::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 9;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: var(--ds-grain-max);
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.95' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .2  0 0 0 0 .1  0 0 0 0 .44  0 0 0 1.1 -.2'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }
  p, h1, h2, h3, ul, ol, li, figure, blockquote { margin: 0; padding: 0; list-style: none; text-wrap: pretty; }
  .mis { position: relative; display: block; }
  .mis > .ink { position: relative; display: block; mix-blend-mode: multiply; }
  .mis > .pl { position: absolute; left: var(--ds-space-1); top: calc(var(--ds-space-1) * -0.5); width: 100%; height: 100%; pointer-events: none; mix-blend-mode: multiply; }
  .mis > .pl::before { content: attr(data-mis); display: block; color: var(--ds-color-pink); }
  .num { font-family: var(--ds-font-num); font-variant-numeric: tabular-nums lining-nums; }
  .stamp { box-sizing: border-box; display: grid; place-items: center; border-radius: var(--ds-radius-disc); background: var(--ds-color-pink); color: var(--ds-color-purple); font-family: var(--ds-font-display); line-height: 1.05; text-align: center; text-wrap: balance; mix-blend-mode: multiply; }
  .band { background-image: repeating-linear-gradient(-45deg, var(--ds-color-pink) 0 var(--ds-space-1), transparent var(--ds-space-1) var(--ds-space-2)); mix-blend-mode: multiply; }
  .dots { background-image: radial-gradient(circle, var(--ds-color-pink) 0 36%, transparent 38%); background-size: var(--ds-space-2) var(--ds-space-2); mix-blend-mode: multiply; }
  .dots-blue { background-image: radial-gradient(circle, var(--ds-color-blue) 0 30%, transparent 32%); background-size: var(--ds-space-2) var(--ds-space-2); mix-blend-mode: multiply; }

  :scope { padding: var(--ds-space-7) var(--ds-space-6); display: flex; align-items: center; }
  .ticket { position: relative; width: 100%; height: 100%; box-sizing: border-box; display: grid; grid-template-columns: 1fr var(--ds-space-10); background: var(--ds-color-paper-deep); }
  .ticket::before { content: ""; position: absolute; left: var(--ds-space-2); top: 0; bottom: 0; width: var(--ds-space-3); background-image: radial-gradient(circle, var(--ds-color-paper) 0 40%, transparent 42%); background-size: var(--ds-space-3) var(--ds-space-4); }
  .main { padding: var(--ds-space-7) var(--ds-space-6) var(--ds-space-6) var(--ds-space-7); display: flex; flex-direction: column; }
  .main .items { flex: 1; display: flex; flex-direction: column; justify-content: space-around; }
  .heading { font-family: var(--ds-font-cjk-strong); font-weight: 700; font-size: var(--ds-type-head); line-height: 1.2; padding-bottom: var(--ds-space-4); border-bottom: 6px solid var(--ds-color-blue); }
  .items li { padding: var(--ds-space-4) 0; border-bottom: 2px solid var(--ds-color-blue); font-size: var(--ds-type-lead); line-height: 1.35; }
  .stub { border-left: 4px dashed var(--ds-color-blue); padding: var(--ds-space-7) var(--ds-space-4); display: flex; flex-direction: column; align-items: center; justify-content: space-between; text-align: center; }
  .count { font-family: var(--ds-font-num); font-weight: 700; font-size: var(--ds-type-display); line-height: 1; }
  .count small { display: block; font-family: var(--ds-font-cjk-strong); font-size: var(--ds-type-lead); }
  .foot { font-size: var(--ds-type-note); line-height: 1.4; }
  @media (min-aspect-ratio: 9/10) and (max-aspect-ratio: 11/10) { .heading { font-size: var(--ds-type-sub); } .items li { padding: var(--ds-space-2) 0; font-size: var(--ds-type-body); } .main { padding-top: var(--ds-space-6); } .count { font-size: var(--ds-type-title); } }
  @media (min-aspect-ratio: 2/1) {
    :scope { padding: var(--ds-space-3) var(--ds-space-4); }
    .ticket { grid-template-columns: 1fr var(--ds-space-9); }
    .main { padding: var(--ds-space-3) var(--ds-space-4) var(--ds-space-3) var(--ds-space-6); }
    .heading { font-size: var(--ds-type-body); padding-bottom: var(--ds-space-1); border-bottom-width: 3px; }
    .main .items { display: grid; grid-template-columns: 1fr 1fr; column-gap: var(--ds-space-4); align-content: start; }
    .items li { font-size: var(--ds-type-caption); padding: var(--ds-space-1) 0; border-bottom-width: 1px; }
    .stub { padding: var(--ds-space-3) var(--ds-space-2); }
    .count { font-size: var(--ds-type-head); }
    .count small { font-size: var(--ds-type-caption); }
    .foot { font-size: var(--ds-type-caption); }
  }
</style>
<div class="ticket" data-ds-enter="left" data-ds-step="feed" data-ds-ease="feed" data-ds-order="0">
  <div class="main">
    <h2 class="heading">{{ slots.heading }}</h2>
    <ul class="items" data-ds-stagger="line">{% for item in slots.items %}<li data-ds-enter="fade" data-ds-order="{{ forloop.index }}">{{ item }}</li>{% endfor %}</ul>
  </div>
  <div class="stub"><p class="count num">{{ slots.items.size }}<small>项</small></p><p class="foot">{{ slots.footnote }}</p></div>
</div>
