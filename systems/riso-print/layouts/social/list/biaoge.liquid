{% comment %}
表格 biaoge：清单的表。标题思源黑体粗 head 档，下方一条粉色斜纹带；条目逐行横排，行首两位等宽序号（Space Grotesk），每行一道蓝色细线；
脚注印在一条粉色实地上（紫字）。不错版。方形、公众号封面把条目排成两栏。
{% endcomment %}
<style>
  :scope {
    box-sizing: border-box;
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--ds-color-paper);
    color: var(--ds-color-blue);
    font-family: var(--ds-font-body);
    line-height: 1.5;
  }
  :scope::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 9;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: var(--ds-grain-max);
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.95' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .2  0 0 0 0 .1  0 0 0 0 .44  0 0 0 1.1 -.2'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }
  p, h1, h2, h3, ul, ol, li, figure, blockquote { margin: 0; padding: 0; list-style: none; text-wrap: pretty; }
  .mis { position: relative; display: block; }
  .mis > .ink { position: relative; display: block; mix-blend-mode: multiply; }
  .mis > .pl { position: absolute; left: var(--ds-space-1); top: calc(var(--ds-space-1) * -0.5); width: 100%; height: 100%; pointer-events: none; mix-blend-mode: multiply; }
  .mis > .pl::before { content: attr(data-mis); display: block; color: var(--ds-color-pink); }
  .num { font-family: var(--ds-font-num); font-variant-numeric: tabular-nums lining-nums; }
  .stamp { box-sizing: border-box; display: grid; place-items: center; border-radius: var(--ds-radius-disc); background: var(--ds-color-pink); color: var(--ds-color-purple); font-family: var(--ds-font-display); line-height: 1.05; text-align: center; text-wrap: balance; mix-blend-mode: multiply; }
  .band { background-image: repeating-linear-gradient(-45deg, var(--ds-color-pink) 0 var(--ds-space-1), transparent var(--ds-space-1) var(--ds-space-2)); mix-blend-mode: multiply; }
  .dots { background-image: radial-gradient(circle, var(--ds-color-pink) 0 36%, transparent 38%); background-size: var(--ds-space-2) var(--ds-space-2); mix-blend-mode: multiply; }
  .dots-blue { background-image: radial-gradient(circle, var(--ds-color-blue) 0 30%, transparent 32%); background-size: var(--ds-space-2) var(--ds-space-2); mix-blend-mode: multiply; }

  :scope { padding: var(--ds-space-7) var(--ds-space-6); display: flex; flex-direction: column; counter-reset: row; }
  .heading { font-family: var(--ds-font-cjk-strong); font-weight: 700; font-size: var(--ds-type-head); line-height: 1.15; }
  .band { height: var(--ds-space-4); margin-top: var(--ds-space-4); }
  .items { margin-top: var(--ds-space-5); display: grid; grid-auto-rows: auto; }
  .items li { counter-increment: row; display: grid; grid-template-columns: var(--ds-space-8) 1fr; align-items: baseline; padding: var(--ds-space-4) 0; border-bottom: 2px solid var(--ds-color-blue); font-size: var(--ds-type-sub); line-height: 1.3; }
  .items li::before { content: counter(row, decimal-leading-zero); font-family: var(--ds-font-num); font-weight: 700; font-size: var(--ds-type-lead); font-variant-numeric: tabular-nums; }
  .foot { margin-top: auto; align-self: flex-start; padding: var(--ds-space-2) var(--ds-space-4); background: var(--ds-color-pink); color: var(--ds-color-purple); font-family: var(--ds-font-cjk-strong); font-weight: 700; font-size: var(--ds-type-lead); mix-blend-mode: multiply; }
  @media (min-aspect-ratio: 9/10) and (max-aspect-ratio: 11/10) { .items { grid-template-columns: 1fr 1fr; column-gap: var(--ds-space-5); } .items li { font-size: var(--ds-type-body); padding: var(--ds-space-3) 0; grid-template-columns: var(--ds-space-6) 1fr; } .items li::before { font-size: var(--ds-type-body); } .heading { font-size: var(--ds-type-sub); } }
  @media (min-aspect-ratio: 2/1) {
    :scope { padding: var(--ds-space-4) var(--ds-space-6); display: grid; grid-template-columns: 1fr auto; grid-template-rows: auto auto 1fr; column-gap: var(--ds-space-5); }
    .heading { font-size: var(--ds-type-lead); grid-column: 1; grid-row: 1; }
    .foot { grid-column: 2; grid-row: 1; align-self: center; margin-top: 0; font-size: var(--ds-type-caption); padding: var(--ds-space-1) var(--ds-space-3); }
    .band { grid-column: 1 / 3; grid-row: 2; height: var(--ds-space-2); margin-top: var(--ds-space-2); }
    .items { grid-column: 1 / 3; grid-row: 3; margin-top: var(--ds-space-2); grid-template-columns: 1fr 1fr; column-gap: var(--ds-space-6); align-content: start; }
    .items li { font-size: var(--ds-type-caption); padding: var(--ds-space-1) 0; grid-template-columns: var(--ds-space-5) 1fr; border-bottom-width: 1px; }
    .items li::before { font-size: var(--ds-type-caption); }
  }
</style>
<h2 class="heading" data-ds-enter="rise" data-ds-step="feed" data-ds-ease="feed" data-ds-distance="2" data-ds-order="0">{{ slots.heading }}</h2>
<div class="band" aria-hidden="true"></div>
<ul class="items" data-ds-stagger="line">{% for item in slots.items %}<li data-ds-enter="fade" data-ds-order="{{ forloop.index }}">{{ item }}</li>{% endfor %}</ul>
<p class="foot" data-ds-enter="fade" data-ds-order="9">{{ slots.footnote }}</p>
