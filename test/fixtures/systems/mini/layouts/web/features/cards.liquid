<style>
  :scope {
    box-sizing: border-box;
    padding: calc(var(--ds-space-3) * 2) var(--ds-space-3);
    background: var(--ds-color-paper);
    color: var(--ds-color-ink);
    font-family: var(--ds-font-body);
  }
  .heading { margin: 0 0 var(--ds-space-3); font-weight: 400; font-size: var(--ds-type-2); line-height: 1.3; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--ds-space-3); }
  .card { box-sizing: border-box; min-height: 160px; padding: var(--ds-space-2); border: 1px solid var(--ds-color-accent); }
  .card-title { margin: 0; font-weight: 400; font-size: var(--ds-type-1); line-height: 1.4; }
  .card-body { margin: 0; font-size: var(--ds-type-0); line-height: 1.6; }
</style>
<h2 class="heading">{{ slots.heading }}</h2>
<div class="cards">{% for title in slots.itemTitles %}<div class="card"><h3 class="card-title">{{ title }}</h3><p class="card-body">{{ slots.itemBodies[forloop.index0] }}</p></div>{% endfor %}</div>
